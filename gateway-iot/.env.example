# Copy this file to .env and change the passwords.
# The .env file is ignored by git: never commit real passwords.

# Who this gateway is
SITE_ID=site01
GATEWAY_ID=gw-site01

# Local broker (on the site, where the ESP32 sensors publish)
SITE_BROKER_HOST=site-broker
SITE_BROKER_PORT=1883

# Cloud broker (MQTTS). In dev it is the "cloud-broker" container.
CLOUD_BROKER_HOST=cloud-broker
CLOUD_BROKER_PORT=8883
# Must be the same as SITE_ID (the broker ACL uses it to limit the gateway to its own site)
CLOUD_GATEWAY_USER=site01
CLOUD_GATEWAY_PASSWORD=change-me-gateway
# Account the WildFly backend will use to read readings from the cloud broker
# Keep this username as "backend": the broker ACL names it literally.
CLOUD_BACKEND_USER=backend
CLOUD_BACKEND_PASSWORD=change-me-backend

# Local MongoDB for backend development
MONGO_ROOT_USER=coldtrace-root
MONGO_ROOT_PASSWORD=change-me-mongo-root
MONGO_APP_USER=coldtrace-app
MONGO_APP_PASSWORD=change-me-mongo-app
MONGO_DB=coldtrace

# Buffer while the cloud is unreachable
BUFFER_MAX=20000
REPLAY_BATCH=50

# Fake sensors
SIM_INTERVAL_MS=5000
SIM_BAD_RATE=0.05
SIM_RANDOM_DOOR=false
SIM_FAULTS=
SIM_CONTROL_PORT=4000
