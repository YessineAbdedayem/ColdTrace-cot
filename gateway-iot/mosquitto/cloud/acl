# Who can do what on the cloud broker.
# Each gateway logs in with its site id as username (for example "site01").
# %u is replaced by that username, so a gateway can only write under
# its own site and cannot read other sites.
pattern write coldtrace/%u/+/telemetry
pattern write coldtrace/%u/gateway/status
pattern read  coldtrace/%u/+/cmd

# DEV ONLY: one local gateway (site01) serves the site02 and site03 simulators.
# In production, each site has its own gateway and matching broker user.
user site01
topic write coldtrace/site02/+/telemetry
topic write coldtrace/site03/+/telemetry

# The backend (WildFly) reads everything and can send commands
user backend
topic read  coldtrace/#
topic write coldtrace/+/+/cmd
