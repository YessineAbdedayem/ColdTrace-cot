      "name": "6. Alerts on phones (Web Push)",
      "item": [
        {
          "name": "Push status and public key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/api/push",
              "host": [
                "{{apiUrl}}"
              ],
