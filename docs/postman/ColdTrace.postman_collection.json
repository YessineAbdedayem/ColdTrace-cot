            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.enabled) pm.test(\"VAPID key: 65 bytes base64url\", () => pm.expect(body.publicKey).to.match(/^[A-Za-z0-9_-]{87}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Subscription to a foreign host is refused: 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/api/push/subscriptions",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "api",
                "push",
                "subscriptions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"https://example.org/push/x\",\n  \"keys\": {\n    \"p256dh\": \"BAAA\",\n    \"auth\": \"AAAA\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ],
      "description": "A real subscription needs a browser: use the front office's \"Enable alerts on this device\" button."
