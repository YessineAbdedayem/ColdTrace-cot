# Copy this file to .env and change the password. The .env file is ignored by git.

# MongoDB user for the MLOps pipeline: reads the platform data (coldtrace),
# writes only its own database (coldtrace_ml). Created by: docker compose run --rm ml-user
ML_MONGO_USER=coldtrace-ml
ML_MONGO_PASSWORD=change-me-ml

# Databases
ML_DB=coldtrace_ml
SOURCE_DB=coldtrace

# Automatic retraining by the monitor (pipeline/retrain.py): true, or false to only log what it would do
AUTO_RETRAIN=true
