batch
set pathTo=`:resolve-expression(expression=${default.path})`
set aliasTo=`:resolve-expression(expression=${default.aliases})`
set spaPath=`:resolve-expression(expression=${default.path}/index.html)`
set corsRegex=`:resolve-expression(expression="regex(pattern='^(https:\\/\\/(?:.+\\.)?${default.domains}(?::\\d{1,5})?(\\/([a-zA-Z0-9\\-_?&=%.;:+]{2,})?)*)$',value=%{i,Origin},full-match=true)"`
set escaped=\"$corsRegex\"
/subsystem=undertow/configuration=handler/file=welcome-content:write-attribute(name=path,value=$pathTo)
/subsystem=undertow/server=default-server/host=default-host:write-attribute(name=alias,value=[$aliasTo])
/subsystem=undertow/configuration=filter/response-header=hsts-header:add(header-name=Strict-Transport-Security,header-value="max-age=63072000; includeSubDomains; preload")
/subsystem=undertow/configuration=filter/rewrite=http-to-https:add(target="https://%v%U",redirect=true)
/subsystem=undertow/server=default-server/host=default-host/filter-ref=hsts-header:add(predicate="equals(%p,443)")
/subsystem=undertow/server=default-server/host=default-host/filter-ref=http-to-https:add(predicate="equals(%p,80)")
/subsystem=undertow/configuration=filter/error-page=spa-default-router:add(code="404",path=$spaPath)
/subsystem=undertow/server=default-server/host=default-host/filter-ref=spa-default-router:add(predicate="true")
/subsystem=undertow/configuration=filter/response-header=cache-control:add(header-name=Cache-Control,header-value="private,no-cache")
/subsystem=undertow/server=default-server/host=default-host/filter-ref=cache-control:add(predicate="true")
/subsystem=undertow/configuration=filter/response-header=content-type-options:add(header-name=X-Content-Type-Options,header-value="nosniff")
/subsystem=undertow/server=default-server/host=default-host/filter-ref=content-type-options:add(predicate="true")
/subsystem=undertow/configuration=filter/response-header="Access-Control-Allow-Origin":add(header-name="Access-Control-Allow-Origin",header-value="*")
/subsystem=undertow/configuration=filter/response-header="Access-Control-Allow-Methods":add(header-name="Access-Control-Allow-Methods",header-value="GET, POST, OPTIONS, HEAD, PUT, PATCH, DELETE")
/subsystem=undertow/configuration=filter/response-header="Access-Control-Allow-Headers":add(header-name="Access-Control-Allow-Headers",header-value="accept, authorization, content-type, x-requested-with, if-match, if-none-match")
/subsystem=undertow/configuration=filter/response-header="Access-Control-Expose-Headers":add(header-name="Access-Control-Expose-Headers",header-value="strict-transport-security, content-security-policy, content-type, content-encoding, date, location, last-modified, etag, link")
/subsystem=undertow/configuration=filter/response-header="Access-Control-Allow-Credentials":add(header-name="Access-Control-Allow-Credentials",header-value="true")
/subsystem=undertow/configuration=filter/response-header="Access-Control-Max-Age":add(header-name="Access-Control-Max-Age",header-value="1")
/subsystem=undertow/server=default-server/host=default-host/filter-ref="Access-Control-Allow-Origin":add(predicate=$escaped)
/subsystem=undertow/server=default-server/host=default-host/filter-ref="Access-Control-Allow-Methods":add(predicate=$escaped)
/subsystem=undertow/server=default-server/host=default-host/filter-ref="Access-Control-Allow-Headers":add(predicate=$escaped)
/subsystem=undertow/server=default-server/host=default-host/filter-ref="Access-Control-Expose-Headers":add(predicate=$escaped)
/subsystem=undertow/server=default-server/host=default-host/filter-ref="Access-Control-Allow-Credentials":add(predicate=$escaped)
/subsystem=undertow/server=default-server/host=default-host/filter-ref="Access-Control-Max-Age":add(predicate=$escaped)
run-batch
reload